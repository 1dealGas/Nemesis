[bootstrap]
main_collection = /Viewer.collectionc
render = /System/Viewer.renderc

[script]
shared_state = 1

[display]
width = 1800
height = 1080

[project]
title = Nemesis
version = 0.2.1
publisher = 1dealGas
developer = 1dealGas
custom_resources = Viewer.wav, Viewer.license

[input]
use_accelerometer = 0
game_binding = /System/Viewer.input_bindingc
repeat_interval = 0.1
gamepads = /System/Viewer.gamepadsc

[network]
http_cache_enabled = 0
http_thread_count = 0

[native_extension]
app_manifest = /System/Viewer.appmanifest

[resource]
max_resources = 61

[graphics]
verify_graphics_calls = 0
texture_profiles = /System/Viewer.texture_profiles

[collection]
max_instances = 4603
max_input_stack_entries = 1

[osx]
bundle_identifier = ideal.nemesis
app_icon = /System/Viewer.icns
bundle_name = Nemesis
bundle_version = 0.2.1

[windows]
app_icon = /System/Viewer.ico

[collectionfactory]
max_count = 0

[collection_proxy]
max_count = 0

[sprite]
max_count = 4610

[tilemap]
max_count = 0
max_tile_count = 0

[particle_fx]
max_count = 0
max_emitter_count = 0
max_particle_count = 0
max_particle_buffer_count = 0

[mesh]
max_count = 0

[label]
max_count = 12

[gui]
max_count = 0
max_particlefx_count = 0
max_animation_count = 0
max_particle_count = 0

[factory]
