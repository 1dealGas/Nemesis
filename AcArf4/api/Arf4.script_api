- name: Arf4
  type: table
  desc: Aerials Chart[Fumen] Format v4
  members:

  - name: LoadArf
    type: function
    parameters:
    - name: path
      type: string
    - name: is_auto
      type: boolean
    - name: proof
      type: [string, nil]
    returns:
    - name: before
      type: [number, nil]
    - name: object_count
      type: [number, nil]
    - name: wgo_required
      type: [number, nil]
    - name: hgo_required
      type: [number, nil]
    - name: ego_required
      type: [number, nil]

  - name: ExportArf
    type: function
    parameters:
    - name: proof
      type: [string, nil]
    returns:
    - name: result
      type: [string, nil]

  - name: UpdateArf
    type: function
    parameters:
    - name: ms
      type: number
    - name: delay
      type: [number, boolean]
    - name: wish_gos
      type: table
    - name: hint_gos
      type: table
    - name: echo_gos
      type: table
    - name: echo_helper_gos
      type: table
    - name: left_anim_gos
      type: table
    - name: right_anim_gos
      type: table
    - name: wish_tints
      type: table
    - name: hint_tints
      type: table
    - name: echo_tints
      type: table
    - name: echo_helper_tints
      type: table
    - name: anim_tints
      type: table
    returns:
    - name: wish_go_used
      type: number
    - name: hint_go_used
      type: number
    - name: echo_go_used
      type: number
    - name: echo_helper_go_used
      type: number
    - name: anim_go_used
      type: number
    - name: hint_play_hitsound
      type: boolean
    - name: echo_play_hitsound
      type: boolean

  - name: NewSeries
    type: function
    parameters:
    - name: keyframes
      type: table
    returns:
    - name: series
      type: [table, nil]

  - name: SetCam
    type: function
    parameters:
    - name: x_scale
      type: number
    - name: y_scale
      type: number
    - name: x_delta
      type: number
    - name: camera_speed
      type: number

  - name: CosSin
    type: function
    parameters:
    - name: degree
      type: number
    returns:
    - name: cos
      type: number
    - name: sin
      type: number

  - name: Ease
    type: function
    parameters:
    - name: ms
      type: number
    - name: all_series
      type: table
    - name: results
      type: table


  - name: JudgeArf
    type: function
    desc: Player Only
    parameters:
    - name: xs
      type: table
    - name: ys
      type: table
    - name: phases
      type: table

  - name: SetOptions
    type: function
    desc: Player Only
    parameters:
    - name: input_delta_ms
      type: number
    - name: player_speed
      type: number

  - name: SetJudgeZone
    type: function
    desc: Player Only
    parameters:
    - name: ms
      type: number
    - name: is_any_x
      type: boolean
    - name: is_any_y
      type: boolean

  - name: SetJudgeStat
    type: function
    desc: Player Only
    parameters:
    - name: hint_hit
      type: number
    - name: echo_hit
      type: number
    - name: early
      type: number
    - name: late
      type: number
    - name: lost
      type: number
    - name: special_hint_hit
      type: number

  - name: GetJudgeStat
    type: function
    desc: Player Only
    returns:
    - name: hint_hit
      type: number
    - name: echo_hit
      type: number
    - name: early
      type: number
    - name: late
      type: number
    - name: lost
      type: number
    - name: special_hint_hit
      type: number


  - name: NewBuild
    type: function
    desc: Viewer Only
    parameters:
    - name: args
      type: table
    returns:
    - name: ok
      type: boolean
    - name: err
      type: [string, nil]

  - name: SetDelta
    type: function
    desc: Viewer Only
    parameters:
    - name: args
      type: table
    returns:
    - name: ok
      type: boolean
    - name: err
      type: [string, nil]

  - name: NewWish
    type: function
    desc: Viewer Only
    parameters:
    - name: args
      type: table
    returns:
    - name: wish
      type: [table, nil]
    - name: err
      type: [string, nil]

  - name: NewHint
    type: function
    desc: Viewer Only
    parameters:
    - name: args
      type: table
    returns:
    - name: ok
      type: boolean
    - name: err
      type: [string, nil]

  - name: NewEcho
    type: function
    desc: Viewer Only
    parameters:
    - name: args
      type: table
    returns:
    - name: ok
      type: boolean
    - name: err
      type: [string, nil]

  - name: NewChild
    type: function
    desc: Viewer Only
    parameters:
    - name: args
      type: table
    returns:
    - name: ok
      type: boolean
    - name: err
      type: [string, nil]

  - name: NewHelper
    type: function
    desc: Viewer Only
    parameters:
    - name: args
      type: table
    returns:
    - name: helper
      type: [table, nil]
    - name: err
      type: [string, nil]

  - name: SinceTone
    type: function
    desc: Viewer Only
    parameters:
    - name: set_to
      type: [number, nil]
    returns:
    - name: since_tone
      type: [number, nil]

  - name: OrganizeArf
    type: function
    desc: Viewer Only
    returns:
    - name: before
      type: [number, boolean]
    - name: objcnt_or_err
      type: [number, string]
    - name: wgo_required
      type: [number, nil]
    - name: hgo_required
      type: [number, nil]
    - name: ego_required
      type: [number, nil]

  - name: GetFileMtime
    type: function
    desc: Viewer Only
    parameters:
    - name: path
      type: string
    returns:
    - name: modification_time
      type: [number, nil]

  - name: ConvTime
    type: function
    desc: Viewer Only
    parameters:
    - name: from
      type: [number, table]
    - name: mode
      type: [number, nil]
      desc: (0) toTone  (1) barToMs  (2) toneToMs
    returns:
    - name: result
      type: number