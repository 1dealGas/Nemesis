local HEADER, NIL = [[
local Arf4, Assert, STATIC, LINEAR, INSINE, OUTSINE = Arf4, assert, 0, 1, 2, 3
local Verse, Mirror, DeltaTone = Arf4.NewVerse, Arf4.Mirror, Arf4.DeltaTone
local function NM_WRAP(x) return  function(y) return Assert(x(y)) end  end
local Wish, Hint, Echo = NM_WRAP(Arf4.NewWish), NM_WRAP(Arf4.NewHint), NM_WRAP(Arf4.NewEcho)
local Child, Helper = NM_WRAP(Arf4.NewChild), NM_WRAP(Arf4.NewHelper)
local Time, Delta = NM_WRAP(Arf4.NewBuild), NM_WRAP(Arf4.SetDelta);
]], function() end


-- Env & Audio
--
local WorksCmd
local Proof, FumenLoaded   -- FumenLoaded: A Closure to reload the Fumen if updated. Nullable.
local MessageLabel = msg.url("Nm:/Viewer#[Message]")

local Audio, AudioLen, AudioPlaying
local PlayUnit, StopUnit = AcAudio.PlayUnit, AcAudio.StopUnit
local HitSounds, HsWhich = {}, 1

local function LoadAudio(name)
	local ok, data = AcAudio.CreateSource( sys.get_save_file("Nemesis Works", name .. ".opus") )
	if ok then
		return AcAudio.CreateUnit(data)
	end

	-- Try *.wav when *.opus is not available
	--
	ok, data = AcAudio.CreateSource( sys.get_save_file("Nemesis Works", name .. ".wav") )
	if ok then
		return AcAudio.CreateUnit(data)
	end
end


-- Canvas & Fumen
--
local CanvasMs, CanvasBefore, ObjectCount = 0, 0, 0
local XScale, YScale, XDelta, CamSpeed = 1, 1, 0, 1

local WgoCnt, HgoCnt, EgoCnt, AgoCnt = 0, 0, 0, 0
local WGOs, HGOs, EGOs, EHGOs, AlGOs, ArGOs = {}, {}, {}, {}, {}, {}
local WishSprites, HintSprites, EchoSprites, HelperSprites, AlSprites, ArSprites = {}, {}, {}, {}, {}, {}
local WishTints, WishSpecial, HintTints, EchoTints, HelperTints, AnimTints = {}, {}, {}, {}, {}, {}
local LastWgoUsed, LastHgoUsed, LastEgoUsed, LastEhgoUsed, LastAgoUsed = 0, 0, 0, 0, 0

local UPDATE_MSG_FMT = "·][·  %u of %u ms  ·  %u Object(s)"
local SPRITE, WISHSP, WISH, DOT, NM = hash "Sprite", hash "WishSP", hash "Wish", hash "Echodot", hash "Nm"
local ENABLE, DISABLE, TINTW, TINT = hash "enable", hash "disable", hash "tint.w", hash "tint"

local UpdateArf, SetCam = Arf4.UpdateArf, Arf4.SetCam
local go_set, msg_post, sprite_play_flipbook = go.set, msg.post, sprite.play_flipbook
local label_set_text, string_format = label.set_text, string.format

local function AllocCanvas(wr, hr, er)
	local factory_create, vmath_vector4, msg_url = factory.create, vmath.vector4, msg.url
	local Echoc, Helperc = msg_url("Nm:/Viewer#Echoc"), msg_url("Nm:/Viewer#Helperc")
	local Wishc, Hintc = msg_url("Nm:/Viewer#Wishc"), msg_url("Nm:/Viewer#Hintc")
	local Animc = msg_url("Nm:/Viewer#Animc")
	local ar = hr + er

	if wr > WgoCnt then
		for i = WgoCnt+1, wr do
			local W = factory_create(Wishc)
			WGOs[i], WishSprites[i], WishTints[i] = W, msg_url(NM, W, SPRITE), 0				end
		WgoCnt = wr
	end

	if hr > HgoCnt then
		for i = HgoCnt+1, hr do
			local H = factory_create(Hintc)
			HGOs[i], HintSprites[i] = H, msg_url(NM, H, SPRITE)
			HintTints[i] = vmath_vector4(0,0,0,1)												end
		HgoCnt = hr
	end

	if er > EgoCnt then
		for i = EgoCnt+1, er do
			local E = factory_create(Echoc)
			EGOs[i], EchoSprites[i], EchoTints[i] = E, msg_url(NM, E, SPRITE), vmath_vector4()
			go_set( msg_url(NM, E, DOT), TINTW, 0.637 )

			local EH = factory_create(Helperc)
			EHGOs[i], HelperSprites[i], HelperTints[i] = EH, msg_url(NM, EH, SPRITE), 0			end
		EgoCnt = er
	end

	if ar > AgoCnt then
		for i = AgoCnt+1, ar do
			local AL, AR = factory_create(Animc), factory_create(Animc)
			AlGOs[i], AlSprites[i] = AL, msg_url(NM, AL, SPRITE)
			ArGOs[i], ArSprites[i] = AR, msg_url(NM, AR, SPRITE)
			AnimTints[i] = vmath_vector4()														end
		AgoCnt = ar
	end

	LastWgoUsed, LastHgoUsed, LastEgoUsed, LastAgoUsed = 0, 0, 0, 0
	for i = 1, wr do	msg_post(WishSprites[i], DISABLE)		end
	for i = 1, hr do	msg_post(HGOs[i], DISABLE)				end
	for i = 1, er do	msg_post(HelperSprites[i], DISABLE)
						msg_post(EGOs[i], DISABLE)				end
	for i = 1, ar do	msg_post(AlSprites[i], DISABLE)
						msg_post(ArSprites[i], DISABLE)			end
end

local function CreateNlenv()
	local G = {}
	G.Arf4, G.assert, G.pairs, G.ipairs, G.next, G.print = Arf4, assert, pairs, ipairs, next, print
	G.select, G.tonumber, G.tostring, G.type, G.unpack, G.bit = select, tonumber, tostring, type, unpack, bit
	G.math, G.string, G.table = math, string, table
	return G
end

local function UpdateCanvas(dt)
	if CanvasMs >= CanvasBefore then
		return
	end

	-- Args
	--
	SetCam(XScale, YScale, XDelta, CamSpeed)
	local wu, hu, eu, xu, au, hp, ep = UpdateArf(CanvasMs, dt,
		WGOs, HGOs, EGOs, EHGOs, AlGOs, ArGOs, WishTints, HintTints, EchoTints, HelperTints, AnimTints
	)
	for i = 1, wu do
		local wishSprite, wishTint = WishSprites[i], WishTints[i]
		local isSpecial, lastSpecial = wishTint < 0, WishSpecial[i]
		go_set(wishSprite, TINTW, isSpecial and -wishTint or wishTint)

		if isSpecial ~= lastSpecial then
			sprite_play_flipbook(wishSprite, isSpecial and WISHSP or WISH)
			WishSpecial[i] = isSpecial
		end
	end

	for i = 1, hu do	go_set(HintSprites[i], TINT, HintTints[i])			end
	for i = 1, eu do	go_set(EchoSprites[i], TINT, EchoTints[i])			end
	for i = 1, xu do	go_set(HelperSprites[i], TINTW, HelperTints[i])		end
	for i = 1, au do	go_set(AlSprites[i], TINT, AnimTints[i])
						go_set(ArSprites[i], TINT, AnimTints[i])			end

	-- Enable / Disable
	--
	if wu > LastWgoUsed then
		for i = LastWgoUsed+1, wu do	msg_post(WishSprites[i], ENABLE)	end
	elseif LastWgoUsed > wu then
		for i = wu+1, LastWgoUsed do	msg_post(WishSprites[i], DISABLE)	end
	end

	if hu > LastHgoUsed then
		for i = LastHgoUsed+1, hu do	msg_post(HGOs[i], ENABLE)			end
	elseif LastHgoUsed > hu then
		for i = hu+1, LastHgoUsed do	msg_post(HGOs[i], DISABLE)			end
	end

	if eu > LastEgoUsed then
		for i = LastEgoUsed+1, eu do	msg_post(EGOs[i], ENABLE)			end
	elseif LastEgoUsed > eu then
		for i = eu+1, LastEgoUsed do	msg_post(EGOs[i], DISABLE)			end
	end

	if xu > LastEhgoUsed then
		for i = LastEhgoUsed+1, xu do	msg_post(HelperSprites[i], ENABLE)	end
	elseif LastEhgoUsed > xu then
		for i = xu+1, LastEhgoUsed do	msg_post(HelperSprites[i], DISABLE)	end
	end

	if au > LastAgoUsed then
		for i = LastAgoUsed+1, au do	msg_post(AlSprites[i], ENABLE)
										msg_post(ArSprites[i], ENABLE)		end
	elseif LastAgoUsed > au then
		for i = au+1, LastAgoUsed do	msg_post(AlSprites[i], DISABLE)
										msg_post(ArSprites[i], DISABLE)		end
	end

	-- Misc
	--
	LastWgoUsed, LastHgoUsed, LastEgoUsed, LastEhgoUsed, LastAgoUsed = wu, hu, eu, xu, au
	label_set_text(
		MessageLabel, string_format(UPDATE_MSG_FMT, CanvasMs, CanvasBefore, ObjectCount)
	)
	if dt and (hp or ep) then
		PlayUnit(HitSounds[HsWhich], false)
		HsWhich = (HsWhich == 32) and 1 or (HsWhich+1)
		StopUnit(HitSounds[HsWhich], true)
	end
end

local function LoadFumenAr(PATH, isInitialLoad, AL)
	local b, o, w, h, e = Arf4.LoadArf(PATH, true, Proof)
	if not b then
		return false, "·][· Arf4: Failed to Load the Fumen"
	end

	-- Refresh Canvas
	--
	CanvasBefore, ObjectCount = math.min(b, AL), o
	if isInitialLoad or (CanvasMs > CanvasBefore) then
		CanvasMs = 0
	end

	AllocCanvas(w, h, e)
	UpdateCanvas(0)

	-- Make the Fumen Loaded
	--
	if isInitialLoad then
		local lastModification = lfs.attributes(PATH, "modification")
		return function()
			local modification = lfs.attributes(PATH, "modification")
			if modification then
				if modification ~= lastModification then
					lastModification = modification
					return LoadFumenAr(PATH, false, AudioLen)
				end
			else   -- *.lua deleted
				FumenLoaded = NIL
				return false, "·][· File Listening Aborted"
			end
		end
	end
end

local function LoadFumenNm(PATH, isInitialLoad, AL)
	local scriptFile = io.open(PATH)
	local scriptStr = HEADER .. scriptFile:read("*a")
	scriptFile:close()

	local scriptCompiled, scriptErr = loadstring(scriptStr)
	if not scriptCompiled then
		return false, "·][· Lua: " .. scriptErr
	end

	local callOk, callErr = pcall(setfenv( scriptCompiled, CreateNlenv() ))
	if not callOk then
		return false, "·][· Lua: " .. callErr
	end

	local b, o, w, h, e = Arf4.OrganizeArf()
	if not b then
		return false, "·][· " .. o
	end

	-- Refresh Canvas
	--
	CanvasBefore, ObjectCount = math.min(b, AL), o
	if isInitialLoad or (CanvasMs > CanvasBefore) then
		CanvasMs = 0
	end

	AllocCanvas(w, h, e)
	UpdateCanvas(0)

	-- Make the Fumen Loaded
	--
	if isInitialLoad then
		local lastModification = lfs.attributes(PATH, "modification")
		return function()
			local modification = lfs.attributes(PATH, "modification")
			if modification then
				if modification ~= lastModification then
					lastModification = modification
					return LoadFumenNm(PATH, false, AudioLen)
				end
			else   -- *.lua deleted
				FumenLoaded = NIL
				return false, "·][· File Listening Aborted"
			end
		end
	end
end


-- UI & Actions
--
local ProjectName = ""
local COLOR, BLACK, GREY = hash "color", vmath.vector4(0, 0, 0, 1), vmath.vector4(0.37, 0.37, 0.37, 1)
local InputLabel, InputText, InputMode = msg.url("Nm:/Labels#1-Input"), "", false
local Scrolling = false

local WindowCenterX, WindowCenterY, WindowRatio = 900, 540, 1
local CtrlPressed, AltPressed, ButtonPressed = false, false, nil
local ButtonPanels, ButtonXs = nil, {   -- Y range [20,70]
	24, 224,			248, 348,			372, 459.5,			483.5, 558.5,
	582.5, 657.5,		681.5, 756.5,		780.5, 855.5,		879.5, 954.5,
	1278, 1428,			1452, 1602,			1626, 1776
}

local ButtonFns = {
	[1] = function()   -- Args Input
		InputMode = true
		go_set(ButtonPanels[1], TINTW, 0.88)
	end,

	[2] = function()   -- Load
		if AudioPlaying then return end
	--------
		local A1, A2 = LoadAudio(InputText)
		if not A1 then
			label_set_text(MessageLabel, "·][· Audio (*.opus/*.wav) Not Loaded")
		return end

		local pBase = sys.get_save_file("Nemesis Works", InputText)
		if lfs.attributes( pBase .. ".lua" ) then
			local L1, L2 = LoadFumenNm(pBase .. ".lua", true, A2)
			if L1 then
				ProjectName, FumenLoaded = InputText, L1
				Audio, AudioLen = A1, A2
			else
				label_set_text(MessageLabel, L2)
			end
		return end

		if lfs.attributes( pBase .. ".ar" ) then
			local F1, F2 = LoadFumenAr(pBase .. ".ar", true, A2)
			if F1 then
				ProjectName, FumenLoaded = InputText, F1
				Audio, AudioLen = A1, A2
			else
				label_set_text(MessageLabel, F2)
			end
		return end
	--------
		label_set_text(MessageLabel, "·][· Script File Not Found")
	end,

	[3] = function()   -- Bar
		if FumenLoaded and (not AudioPlaying) then
			local val = tonumber(InputText)
			if val then
				val = Arf4.BarToMs(val)
				if val >= 0 and val <= CanvasBefore then
					CanvasMs = val
					UpdateCanvas(0)
				end
			end
		end
	end,

	[4] = function()   -- Ms
		if FumenLoaded and (not AudioPlaying) then
			local val = tonumber(InputText)
			if val and val >= 0 and val <= CanvasBefore then
				CanvasMs = val
				UpdateCanvas(0)
			end
		end
	end,

	[5] = function()   -- Xs
		XScale = tonumber(InputText) or XScale
		UpdateCanvas(0)
	end,

	[6] = function()   -- Ys
		YScale = tonumber(InputText) or YScale
		UpdateCanvas(0)
	end,

	[7] = function()   -- Xd
		XDelta = tonumber(InputText) or XDelta
		UpdateCanvas(0)
	end,

	[8] = function()   -- Cs
		local val = tonumber(InputText)
		if val and val >= 0 and val <= 1.25 then
			CamSpeed = val
			UpdateCanvas(0)
		end
	end,

	[9] = function()   -- Export
		if FumenLoaded then
			local fileName = string.format("%s - %s.ar", ProjectName, os.date"%g%m%d")
			local file, fmOut = io.open( sys.get_save_file("Nemesis Works", fileName) , "wb" ), Arf4.ExportArf(Proof)
			if file and fmOut then
				file:write(fmOut)		file:close()
				os.execute(WorksCmd)
			end
		end
	end,

	[10] = function()  -- Works
		os.execute(WorksCmd)
	end,

	[11] = function()  -- Play
		if FumenLoaded then
			if AudioPlaying then
				StopUnit(Audio, false)
			else
				CanvasMs = CanvasMs > CanvasBefore  and  CanvasBefore  or  CanvasMs
				AcAudio.SetTime(Audio, CanvasMs)
				PlayUnit(Audio, false)
			end
		end
	end
}

local function ButtonOnWhich(x, y)
	if y >= 20 and y <= 70 then
		for i = 1, 11 do
			if x <= ButtonXs[i*2] and x >= ButtonXs[i*2-1] then
				return i
			end
		end
	end
end

local function ProcessButtons(action)
	if action.pressed then
		ButtonPressed = ButtonOnWhich(
			900 + (action.screen_x - WindowCenterX) * WindowRatio,
			540 + (action.screen_y - WindowCenterY) * WindowRatio
		)
		if ButtonPressed then
			go_set(ButtonPanels[ButtonPressed], TINTW, 1)
		end
	elseif action.released and ButtonPressed then
		go_set(ButtonPanels[ButtonPressed], TINTW, 0.73)
		ButtonPressed = ButtonPressed == ButtonOnWhich(
			900 + (action.screen_x - WindowCenterX) * WindowRatio,
			540 + (action.screen_y - WindowCenterY) * WindowRatio
		) and ButtonFns[ButtonPressed]()
	end
end

local InputModeFns = {
	[hash"text"] = function(action)
		if InputText == "" then
			go_set(InputLabel, COLOR, BLACK)
		end
		InputText = InputText .. action.text
		label_set_text( InputLabel, #InputText>13 and InputText:sub(1,11).."··" or InputText )
	end,

	[hash"backspace"] = function(action)
		if action.pressed or action.repeated then
			InputText = string.sub(InputText, 1, -2)
			if InputText == "" then
				go_set(InputLabel, COLOR, GREY)
				label_set_text(InputLabel, "Args Input")
			else
				label_set_text( InputLabel, #InputText>13 and InputText:sub(1,11).."··" or InputText )
			end
		end
	end,

	[hash"touch"] = function(action)
		if action.released then
			InputMode = go_set(ButtonPanels[1], TINTW, 0.73)
		end
		ProcessButtons(action)
	end
}

local ActionFns = {
	[hash"alt"] = function(action)
		if action.pressed then
			AltPressed = true
		elseif action.released then
			AltPressed = false
		end
	end,

	[hash"ctrl"] = function(action)
		if action.pressed then
			CtrlPressed = true
		elseif action.released then
			CtrlPressed = false
		end
	end,

	[hash"touch"] = ProcessButtons,
	[hash"wheel_down"] = function(action)
		if action.value == 1 then
			if FumenLoaded and (not AudioPlaying) then
				local t = (CtrlPressed or AltPressed) and (CanvasMs + 370) or (CanvasMs + 37)
				CanvasMs = t > CanvasBefore  and  CanvasBefore  or  t < 0  and  0  or  t
				UpdateCanvas(0)
				Scrolling = 1
			end
		end
	end,

	[hash"wheel_up"] = function(action)
		if action.value == 1 then
			if FumenLoaded and (not AudioPlaying) then
				local t = (CtrlPressed or AltPressed) and (CanvasMs - 370) or (CanvasMs - 37)
				CanvasMs = t > CanvasBefore  and  CanvasBefore  or  t < 0  and  0  or  t
				UpdateCanvas(0)
				Scrolling = 1
			end
		end
	end,

	[hash"down"] = function(action)
		if action.pressed or action.repeated then
			if FumenLoaded and (not AudioPlaying) then
				local t = (CtrlPressed or AltPressed) and (CanvasMs + 370) or (CanvasMs + 37)
				CanvasMs = t > CanvasBefore  and  CanvasBefore  or  t < 0  and  0  or  t
				UpdateCanvas(0)
			end
		end
	end,

	[hash"up"] = function(action)
		if action.pressed or action.repeated then
			if FumenLoaded and (not AudioPlaying) then
				local t = (CtrlPressed or AltPressed) and (CanvasMs - 370) or (CanvasMs - 37)
				CanvasMs = t > CanvasBefore  and  CanvasBefore  or  t < 0  and  0  or  t
				UpdateCanvas(0)
			end
		end
	end
}


-- Lifecycle
--
local LastPlaying = false
local CheckPlaying, GetTime = AcAudio.CheckPlaying, AcAudio.GetTime

function init(self)
	-- Init Window & UI
	--
	sys.set_update_frequency(15)
	msg.post(".", "acquire_input_focus")
	window.set_listener( function(_, event, data)
		if event == 2 then
			WindowCenterX, WindowCenterY = data.width / 2, data.height / 2
			WindowRatio = 1 / math.min( WindowCenterX / 900, WindowCenterY / 540 )
		end
	end )

	local m, n = window.get_size()
	window.set_position( m/2 - 900, n/2 - 540 )
	WindowCenterX, WindowCenterY, WindowRatio = 900, 540, 1
	window.set_size(1800, 1080)

	local url = msg.url
	ButtonPanels = {
		url "Nm:/Panels#1-Input",		url "Nm:/Panels#2-Load",		url "Nm:/Panels#3-Bar",		url "Nm:/Panels#4-Ms",
		url "Nm:/Panels#5-Xs",			url "Nm:/Panels#6-Ys",			url "Nm:/Panels#7-Xd",		url "Nm:/Panels#8-Cs",
		url "Nm:/Panels#A-Export",		url "Nm:/Panels#B-Works",		url "Nm:/Panels#C-Play"
	}
	for i = 1, 11 do  go_set(ButtonPanels[i], TINTW, 0.73)	end
					  go_set(InputLabel, COLOR, GREY)
	go_set("Nm:/Hint#Model", TINTW, 0.637)

	local SN = sys.get_sys_info().system_name
	if SN == "Windows" then
		WorksCmd = "explorer " .. sys.get_save_file("Nemesis Works", "")
	else
		WorksCmd = (SN=="Darwin" and "open " or "xdg-open ") .. string.gsub( sys.get_save_file("Nemesis Works", "") , "%s", "\\ " )
	end

	-- Init Addon, Proof & License
	--
	local AF = io.open( sys.get_save_file("Nemesis Works", "[Addon]") )
	if AF then
		local newHeader = table.concat{ HEADER, AF:read("*a"), "\n" }
		HEADER = pcall(loadstring(newHeader)) and newHeader or HEADER
		AF:close()
	end

	local PF = io.open( sys.get_save_file("Nemesis Works", "[Proof]") )
	if PF then
		Proof = PF:read("*a")
		PF:close()
	end

	local LF = io.open( sys.get_save_file("Nemesis Works", "[Nemesis License]"), "w" )
	if LF then
		LF:write( sys.load_resource("/Viewer.license") )
		LF:close()
	end
end

function update(self, dt)
	if FumenLoaded then
		AudioPlaying = CheckPlaying(Audio)
		if AudioPlaying then
			local ms = GetTime(Audio)
			if ms > CanvasBefore then
				StopUnit(Audio, false)
				AcAudio.SetTime(Audio, CanvasBefore)
			elseif CanvasMs ~= ms then
				CanvasMs = ms
				UpdateCanvas(dt)
			end
		end
	end
end

function fixed_update(self)
	if AudioPlaying ~= LastPlaying then
		LastPlaying = AudioPlaying
		if AudioPlaying then
			label_set_text("Nm:/Labels#C-Play", "Pause")
			sys.set_update_frequency(0)
		else
			label_set_text("Nm:/Labels#C-Play", "Play")
			sys.set_update_frequency(Scrolling and 0 or 15)
		end
	end

	if not AudioPlaying then
		if Scrolling == 1 then
			sys.set_update_frequency(0)
			Scrolling = 2
		elseif Scrolling == 2 then
			sys.set_update_frequency(15)
			Scrolling = false
		end
	end

	if FumenLoaded then
		local _, msg = FumenLoaded()
		_ = msg and label_set_text(MessageLabel, msg)
	end
end

function on_input(self, action_id, action)
	return true, (InputMode and InputModeFns[action_id] or ActionFns[action_id] or NIL)(action)
end