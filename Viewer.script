local HEADER, NIL = [[
local A = Arf4
local STATIC, LINEAR, INSINE, OUTSINE, _NA = 0,1,2,3, assert
local function _NW(x) return function(y) return _NA(x(y)) end end
local Helper, Delta, Time = _NW(A.NewHelper), _NW(A.SetDelta), _NW(A.NewBuild)
local Wish, Child, Hint, Echo = _NW(A.NewWish), _NW(A.NewChild), _NW(A.NewHint), _NW(A.NewEcho)
local Verse, Mirror, Toneof, SinceTone = A.NewVerse, A.Mirror, A.ConvTime, A.SinceTone
local Log, CosSin, A = Log, A.CosSin;
]], function() end


-- Env & Audio
--
local Title, WorksCmd = "Nemesis", nil
local Proof, FumenLoaded   -- FumenLoaded: A Closure to reload the Fumen if updated. Nullable.
local Info = msg.url("Nm:/Viewer#[Info]")

local Audio, AudioLen, AudioPlaying
local PlayUnit, StopUnit = AcAudio.PlayUnit, AcAudio.StopUnit
local HitSounds, HsWhich = {}, 1

local function LoadAudio(basePath)
	for _, ext in ipairs{ ".opus", ".mp3", ".wav" } do
		local ok, data = AcAudio.CreateSource(basePath..ext)
		if ok then
			return AcAudio.CreateUnit(data)
		end
	end
end


-- Canvas & Fumen
--
local CanvasMs, ObjectCount = 0, 0
local CamSeries, CamVals, LogQueue = {}, {}, {}

local WgoCnt, HgoCnt, EgoCnt, AgoCnt = 0, 0, 0, 0
local WGOs, HGOs, EGOs, EHGOs, AlGOs, ArGOs = {}, {}, {}, {}, {}, {}
local WishSprites, HintSprites, EchoSprites, HelperSprites, AlSprites, ArSprites = {}, {}, {}, {}, {}, {}
local WishTints, WishSpecial, HintTints, EchoTints, HelperTints, AnimTints = {}, {}, {}, {}, {}, {}
local LastWgoUsed, LastHgoUsed, LastEgoUsed, LastEhgoUsed, LastAgoUsed = 0, 0, 0, 0, 0

local UPDATE_FMT = "·][·  %u of %u ms  ·  %u Object(s)"
local ETS, S0, S1 = { [0] = "STATIC", "LINEAR", "INSINE", "OUTSINE" }, Arf4.NewSeries{0,0}, Arf4.NewSeries{0,1}
local ENABLE, DISABLE, TINTW, TINT, NM = hash "enable", hash "disable", hash "tint.w", hash "tint", hash "Nm"
local SPRITE, WISHSP, WISH, ECHO, ANIM = hash "Sprite", hash "WishSP", hash "Wish", hash "Echo", hash "Anim"

local ConvTime, UpdateArf, SetCam, Ease = Arf4.ConvTime, Arf4.UpdateArf, Arf4.SetCam, Arf4.Ease
local go_set, msg_post, sprite_play_flipbook = go.set, msg.post, sprite.play_flipbook
local label_set_text, string_format = label.set_text, string.format

local function EnqueueLog(t, name)
	if t[2] then
		LogQueue[ t.Name or name or os.clock() ] = t
			for i = 1, #t, 3 do
				t[i] = ConvTime(  ConvTime( t[i] ),  2  )   -- [0] toTone  [1] barToMs  [2] toneToMs
			end
		return true
	end
end

local function Xs(t)
	if EnqueueLog(t, "Xs") then
		CamSeries[1] = Arf4.NewSeries(t)
	end
end

local function Ys(t)
	if EnqueueLog(t, "Ys") then
		CamSeries[2] = Arf4.NewSeries(t)
	end
end

local function Xd(t)
	if EnqueueLog(t, "Xd") then
		CamSeries[3] = Arf4.NewSeries(t)
	end
end

local function Cs(t)
	if EnqueueLog(t, "Cs") then
		CamSeries[4] = Arf4.NewSeries(t)
	end
end

local function AllocCanvas(wgoReq, hgoReq, egoReq)
	local factory_create, vmath_vector4 = factory.create, vmath.vector4
	local go_set_scale, go_delete, msg_url = go.set_scale, go.delete, msg.url
	local Wishc, Helc = msg_url("Nm:/Viewer#Wishc"), msg_url("Nm:/Viewer#Helc")
	local Hintc, agoReq = msg_url("Nm:/Viewer#Hintc"), hgoReq + egoReq

	for i = WgoCnt+1, wgoReq do
		local W = factory_create(Wishc)
		WGOs[i], WishSprites[i], WishTints[i] = W, msg_url(NM, W, SPRITE), 0					end
	for i = wgoReq+1, WgoCnt do
		go_delete(WGOs[i])																		end

	for i = HgoCnt+1, hgoReq do
		local H = factory_create(Hintc)
		HGOs[i], HintSprites[i] = H, msg_url(NM, H, SPRITE)
		HintTints[i] = vmath_vector4(1)  ;  go_set_scale(1.237, H)								end
	for i = hgoReq+1, HgoCnt do
		go_delete(HGOs[i])																		end

	for i = EgoCnt+1, egoReq do
		local EH, ES = factory_create(Helc), msg_url( NM, factory_create(Wishc), SPRITE )
		EHGOs[i], HelperSprites[i], HelperTints[i] = EH, msg_url(NM, EH, SPRITE), 0
		EGOs[i], EchoSprites[i], EchoTints[i] = ES.path, ES, vmath_vector4()
		sprite_play_flipbook(ES, ECHO)															end
	for i = egoReq+1, EgoCnt do
		go_delete(EGOs[i])
		go_delete(EHGOs[i])																		end

	for i = AgoCnt+1, agoReq do
		local ALS = msg_url(NM, factory_create(Hintc), SPRITE)
		local ARS = msg_url(NM, factory_create(Hintc), SPRITE)
		AlGOs[i], AlSprites[i] = ALS.path, ALS  ;  sprite_play_flipbook(ALS, ANIM)
		ArGOs[i], ArSprites[i] = ARS.path, ARS  ;  sprite_play_flipbook(ARS, ANIM)
		AnimTints[i] = vmath_vector4()															end
	for i = agoReq+1, AgoCnt do
		go_delete(AlGOs[i])
		go_delete(ArGOs[i])																		end

	WgoCnt, HgoCnt, EgoCnt, AgoCnt = wgoReq, hgoReq, egoReq, agoReq
	for i = 1, WgoCnt do	msg_post(WishSprites[i], DISABLE)	end
	for i = 1, HgoCnt do	msg_post(HintSprites[i], DISABLE)	end
	for i = 1, EgoCnt do	msg_post(HelperSprites[i], DISABLE)
							msg_post(EchoSprites[i], DISABLE)	end
	for i = 1, AgoCnt do	msg_post(AlSprites[i], DISABLE)
							msg_post(ArSprites[i], DISABLE)		end
	LastWgoUsed, LastHgoUsed, LastEgoUsed, LastAgoUsed = 0, 0, 0, 0
end

local function UpdateCanvas(playHs)   -- Should be delegated to update() except LoadFumen*
	Ease(CanvasMs, CamSeries, CamVals)
	SetCam(CamVals[1], CamVals[2], CamVals[3], CamVals[4])
	local wu, hu, eu, xu, au, hp, ep = UpdateArf(CanvasMs - 30, 30,
		WGOs, HGOs, EGOs, EHGOs, AlGOs, ArGOs, WishTints, HintTints, EchoTints, HelperTints, AnimTints
	)

	-- Args
	--
	if not wu then
		wu, hu, eu, xu, au, hp, ep = 0, 0, 0, 0, 0, false, false
	end

	for i = 1, wu do
		local wishSprite, wishTint = WishSprites[i], WishTints[i]
		local isSpecial, lastSpecial = wishTint < 0, WishSpecial[i]
		go_set(wishSprite, TINTW, isSpecial and -wishTint or wishTint)

		if isSpecial ~= lastSpecial then
			sprite_play_flipbook(wishSprite, isSpecial and WISHSP or WISH)
			WishSpecial[i] = isSpecial
		end
	end

	for i = 1, hu do	go_set(HintSprites[i], TINT, HintTints[i])			end
	for i = 1, eu do	go_set(EchoSprites[i], TINT, EchoTints[i])			end
	for i = 1, xu do	go_set(HelperSprites[i], TINTW, HelperTints[i])		end
	for i = 1, au do	go_set(AlSprites[i], TINT, AnimTints[i])
						go_set(ArSprites[i], TINT, AnimTints[i])			end

	-- Enable / Disable & HitSound
	--
	for i = LastWgoUsed+1, wu do	msg_post(WishSprites[i], ENABLE)		end
	for i = wu+1, LastWgoUsed do	msg_post(WishSprites[i], DISABLE)		end

	for i = LastHgoUsed+1, hu do	msg_post(HintSprites[i], ENABLE)		end
	for i = hu+1, LastHgoUsed do	msg_post(HintSprites[i], DISABLE)		end

	for i = LastEgoUsed+1, eu do	msg_post(EchoSprites[i], ENABLE)		end
	for i = eu+1, LastEgoUsed do	msg_post(EchoSprites[i], DISABLE)		end

	for i = LastEhgoUsed+1, xu do	msg_post(HelperSprites[i], ENABLE)		end
	for i = xu+1, LastEhgoUsed do	msg_post(HelperSprites[i], DISABLE)		end

	for i = LastAgoUsed+1, au do	msg_post(AlSprites[i], ENABLE)
									msg_post(ArSprites[i], ENABLE)			end
	for i = au+1, LastAgoUsed do	msg_post(AlSprites[i], DISABLE)
									msg_post(ArSprites[i], DISABLE)			end

	LastWgoUsed, LastHgoUsed, LastEgoUsed, LastEhgoUsed, LastAgoUsed = wu, hu, eu, xu, au
	if playHs and (hp or ep) then
		PlayUnit(HitSounds[HsWhich], false)
		HsWhich = (HsWhich == 32) and 1 or (HsWhich+1)
		StopUnit(HitSounds[HsWhich], true)
	end
end

local function CreateNlenv()
	local G = {}
	G.Arf4, G.bit, G.math, G.string, G.table = Arf4, bit, math, string, table
	G.assert, G.pairs, G.ipairs, G.next, G.pprint = assert, pairs, ipairs, next, pprint
	G.print, G.select, G.tonumber, G.tostring, G.type, G.unpack = print, select, tonumber, tostring, type, unpack
	G.Log, G.Xs, G.Ys, G.Xd, G.Cs = EnqueueLog, Xs, Ys, Xd, Cs
	CamSeries, LogQueue = {S1, S1, S0, S1}, {}
	return G
end

local function CreateReload(PATH, LoadFn, lastModification)
	CanvasMs, lastModification = 0, Arf4.GetFileMtime(PATH)
--------
	return function()
		local modification = Arf4.GetFileMtime(PATH)
		if not modification then   -- *.ar deleted
			FumenLoaded = NIL
			return false, "·][· File Listening Aborted"
		elseif modification ~= lastModification then
			lastModification = modification
			return LoadFn(PATH, false)
		end
	end
end

local function LoadFumenAr(PATH, isBoot)
	local b, o, w, h, e = Arf4.LoadArf(PATH, true, Proof)
	if not b then
		return false, "·][· Arf4: Failed to Load the Fumen"
	end

	AllocCanvas(w, h, e)
	ObjectCount, CamSeries = o, {S1, S1, S0, S1}
	return isBoot and CreateReload(PATH, LoadFumenAr) or true
end

local function LoadFumenNm(PATH, isBoot)
	local scriptFile = io.open(PATH)
	local scriptCompiled, scriptErr = loadstring( scriptFile and HEADER .. scriptFile:read("*a") or PATH )
	if not scriptCompiled then
		return false, "·][· Lua " .. scriptErr
	end

	local callOk, callErr = pcall(setfenv( scriptCompiled, CreateNlenv() ))
	if not callOk then
		return false, "·][· Lua " .. callErr
	end

	local b, o, w, h, e = Arf4.OrganizeArf()
	if not b then
		return false, "·][· " .. o
	end

	ObjectCount = o;  AllocCanvas(w, h, e)
	return isBoot and CreateReload(PATH, LoadFumenNm) or true
end


-- UI & Actions
--
local ProjectName = ""
local COLOR, BLACK, GREY = hash "color", vmath.vector4(0, 0, 0, 1), vmath.vector4(0.37, 0.37, 0.37, 1)
local InputLabel, InputText, InputMode = msg.url("Nm:/Buttons#L1-Input"), "", false

local WindowCenterX, WindowCenterY, WindowRatio = 900, 540, 1
local CtrlPressed, AltPressed, ButtonPressed = false, false, nil
local Panels, Bdy, ButtonXs = nil, 20, {   -- Y range [20,70] or [-70,-20]
	24, 224,			248, 348,			372, 459.5,			483.5, 558.5,
	1278, 1428,			1452, 1602,			1626, 1776
}

local ButtonFns = {
	[1] = function()   -- Args Input
		InputMode, InputText = true, ""
		go_set(Panels[1], TINTW, 0.88) ; go_set(InputLabel, COLOR, GREY)
		label_set_text(InputLabel, "Args Input")
	end,

	[2] = function()   -- Load
		if AudioPlaying then return end
		local pBase = sys.get_save_file("Nemesis Works", InputText)
	--------
		local A1, A2 = LoadAudio(pBase)
			if not A1 then
				label_set_text(Info, "·][· Audio (*.opus/*.mp3/*.wav) Not Loaded")
			return end
		for Ext, loadFn in pairs{  [".lua"] = LoadFumenNm,  [".ar"] = LoadFumenAr  } do
			if Arf4.GetFileMtime( pBase .. Ext ) then
				local L1, L2 = loadFn(pBase .. Ext, true)
				if L1 then
					Audio, AudioLen = A1, A2
					ProjectName, FumenLoaded = InputText, L1
					label_set_text( Info, string_format(UPDATE_FMT, CanvasMs, AudioLen, ObjectCount) )
					window.set_title( string_format("%s -- %s%s", Title, ProjectName, Ext) )
				else
					label_set_text(Info, L2)
				end
			return end
		end
	--------
		label_set_text(Info, "·][· Script File Not Found")
	end,

	[3] = function()   -- Bar
		if FumenLoaded and (not AudioPlaying) then
			local t = ConvTime( tonumber(InputText) or 0, 1 )
			CanvasMs = t < 0  and  0  or  t > AudioLen  and  AudioLen - 10  or  t
			label_set_text( Info,
				string_format(UPDATE_FMT, CanvasMs, AudioLen, ObjectCount)
			)
		end
	end,

	[4] = function()   -- Ms
		if FumenLoaded and (not AudioPlaying) then
			local t = tonumber(InputText) or 0
			CanvasMs = t < 0  and  0  or  t > AudioLen  and  AudioLen - 10  or  t
			label_set_text( Info,
				string_format(UPDATE_FMT, CanvasMs, AudioLen, ObjectCount)
			)
		end
	end,

	[5] = function()   -- Export
		if FumenLoaded then
			local basePath = sys.get_save_file("Nemesis Works", string.format( "%s - %s",  ProjectName,  os.date"%g%m%d" ))
			io.open(basePath..".ar", "wb") : write(  Arf4.ExportArf(Proof)  ) ; io.close()
				if next(LogQueue) then   -- Export Series Log
					local LF = io.open(basePath..".series", "w")
					if LF then
						for name, kf in pairs(LogQueue) do
							LF:write( name .. " {" )
								for i = 1, #kf, 3 do
									LF:write(string_format( "\n	%u, %s, %s,", kf[i], kf[i+1], ETS[ kf[i+2] ] or "UNKNOWN" ))
								end
							LF:write( "\n}\n" )
						end
					LF:close() end
				end
			os.execute(WorksCmd)
		end
	end,

	[6] = function()  -- Works
		os.execute(WorksCmd)
	end,

	[7] = function()  -- Play & Pause
		if FumenLoaded then
			if AudioPlaying then
				StopUnit(Audio, false)
			else
				AcAudio.SetTime(Audio, CanvasMs)
				PlayUnit(Audio, false)
			end
		end
	end
}

local function ButtonOnWhich(x, y)
	if (y >= Bdy) and (y <= Bdy + 50) then
		for i = 1, 7 do
			if x <= ButtonXs[i*2] and x >= ButtonXs[i*2-1] then
				return i
			end
		end
	end
end

local function ProcessButtons(action)
	if action.pressed then
		ButtonPressed = ButtonOnWhich(
			900 + (action.screen_x - WindowCenterX) * WindowRatio,
			540 + (action.screen_y - WindowCenterY) * WindowRatio
		)
		if ButtonPressed then
			go_set(Panels[ButtonPressed], TINTW, 1)
		end
	elseif action.released and ButtonPressed then
		go_set(Panels[ButtonPressed], TINTW, 0.73)
		ButtonPressed = ButtonPressed == ButtonOnWhich(
			900 + (action.screen_x - WindowCenterX) * WindowRatio,
			540 + (action.screen_y - WindowCenterY) * WindowRatio
		) and ButtonFns[ButtonPressed]()
	end
end

local InputModeFns = {
	[hash"text"] = function(action)
		if InputText == "" then
			go_set(InputLabel, COLOR, BLACK)
		end
		InputText = InputText .. action.text
		label_set_text( InputLabel, #InputText>13 and InputText:sub(1,11).."··" or InputText )
	end,

	[hash"backspace"] = function(action)
		if action.pressed or action.repeated then
			InputText = string.sub(InputText, 1, -2)
			if InputText == "" then
				go_set(InputLabel, COLOR, GREY)
				label_set_text(InputLabel, "Args Input")
			else
				label_set_text( InputLabel, #InputText>13 and InputText:sub(1,11).."··" or InputText )
			end
		end
	end,

	[hash"touch"] = function(action)
		if action.released then
			if InputText == "SHOWBG" then		msg_post("Nm:/Viewer", ENABLE);   Bdy = 20
			elseif InputText == "HIDEBG" then	msg_post("Nm:/Viewer", DISABLE);  Bdy = -70
			end									InputMode = go_set(Panels[1], TINTW, 0.73);  go_set("Nm:/Buttons", "position.y", Bdy-20)
		end										ProcessButtons(action)
	end
}

local ActionFns = {
	[hash"touch"] = ProcessButtons,
	[hash"ctrl"] = function(action)		CtrlPressed = not action.released		end,
	[hash"alt"] = function(action)		AltPressed = not action.released		end,

	[hash"up"] = function(action)
		if FumenLoaded and (not AudioPlaying) and (action.pressed or action.repeated) then
			local t = (CtrlPressed or AltPressed) and (CanvasMs - 370) or (CanvasMs - 37)
			CanvasMs = t < 0  and  0  or  t
			label_set_text( Info,
				string_format(UPDATE_FMT, CanvasMs, AudioLen, ObjectCount)
			)
		end
	end,

	[hash"down"] = function(action)
		if FumenLoaded and (not AudioPlaying) and (action.pressed or action.repeated) then
			local t = (CtrlPressed or AltPressed) and (CanvasMs + 370) or (CanvasMs + 37)
			CanvasMs = t > AudioLen  and  AudioLen - 10  or  t
			label_set_text( Info,
				string_format(UPDATE_FMT, CanvasMs, AudioLen, ObjectCount)
			)
		end
	end,

	[hash"wheel_up"] = function(action)
		if FumenLoaded and (not AudioPlaying) and (action.value == 1) then
			local t = (CtrlPressed or AltPressed) and (CanvasMs - 370) or (CanvasMs - 37)
			CanvasMs = t < 0  and  0  or  t
			label_set_text( Info,
				string_format(UPDATE_FMT, CanvasMs, AudioLen, ObjectCount)
			)
		end
	end,

	[hash"wheel_down"] = function(action)
		if FumenLoaded and (not AudioPlaying) and (action.value == 1) then
			local t = (CtrlPressed or AltPressed) and (CanvasMs + 370) or (CanvasMs + 37)
			CanvasMs = t > AudioLen  and  AudioLen - 10  or  t
			label_set_text( Info,
				string_format(UPDATE_FMT, CanvasMs, AudioLen, ObjectCount)
			)
		end
	end
}


-- Lifecycle
--
local LastPlaying = nil
local CheckPlaying, GetTime = AcAudio.CheckPlaying, AcAudio.GetTime
function init()
	-- Init Window & UI
	--
	msg_post("#", "acquire_input_focus")
	window.set_listener( function(_, event, data)
		if event == 2 then   -- Input Adjusting
			WindowCenterX, WindowCenterY = data.width / 2, data.height / 2
			WindowRatio = 1 / math.min( WindowCenterX / 900, WindowCenterY / 540 )
		elseif event == 1 and FumenLoaded then   -- File Listening
			local updated, er = FumenLoaded()
			if updated then		label_set_text( Info, string_format(UPDATE_FMT, CanvasMs, AudioLen, ObjectCount) )
			elseif er then		label_set_text( Info, er )
			end
		end
	end )

	local m, n = window.get_size()
	window.set_position( m/2 - 900, n/2 - 540 )
	window.set_size(1800, 1080)

	local url = msg.url
	Panels = {
		url "Nm:/Buttons#P1-Input",		url "Nm:/Buttons#P2-Load",		url "Nm:/Buttons#P3-Bar",		url "Nm:/Buttons#P4-Ms",
		url "Nm:/Buttons#P5-Export",	url "Nm:/Buttons#P6-Works",		url "Nm:/Buttons#P7-Play"
	}	;			 go_set(InputLabel, COLOR, GREY)
	for i = 1, 7 do  go_set(Panels[i], TINTW, 0.73)	 end
	go_set("Nm:/RenderHint#Quad", TINTW, 0.637)

	-- Init Functions
	--
	timer.delay( 0.2, true, function()																-- Play(Pause) Button
		if AudioPlaying ~= LastPlaying then
			sys.set_engine_throttle(not AudioPlaying, 0.25)
			label_set_text("Nm:/Buttons#L7-Play", AudioPlaying and "Pause" or "Play")
			LastPlaying = AudioPlaying
		end
	end )

	local SN, Dir = sys.get_sys_info().system_name, sys.get_save_file("Nemesis Works", "")			-- Works Button
	if SN == "Windows" then			WorksCmd = string_format("start \"\" \"%s\"", Dir)
	elseif SN == "Darwin" then		WorksCmd = "open " .. string.gsub(Dir, "%s", "\\ ")
	else							WorksCmd = "xdg-open " .. string.gsub(Dir, "%s", "\\ ")
	end

	local CreateUnit, _, HS = AcAudio.CreateUnit, AcAudio.CreateSource("/Viewer.wav")				-- HitSound
	for i = 1, 32 do				HitSounds[i] = CreateUnit(HS)
	end

	local L = io.open( sys.get_save_file("Nemesis Works", "[Nemesis License]"), "w" )				-- License
	if L then L:write( sys.load_resource("/Viewer.license") )		L:close()
	end

	local AF = io.open( sys.get_save_file("Nemesis Works", "[Addon]") )								-- Addon
	if AF then
		local newHeader = table.concat{ HEADER, AF:read("*a"), "\n" }
		if pcall(loadstring(newHeader)) then
			HEADER, Title = newHeader, "Nemesis with Addon"
			window.set_title(Title)
		end
	end

	local PF = io.open( sys.get_save_file("Nemesis Works", "[Proof]") )								-- Proof
	Proof = PF and PF:read("*a")
end

function update()
	if FumenLoaded then
		AudioPlaying = CheckPlaying(Audio)
			if AudioPlaying then
				CanvasMs = GetTime(Audio)
				label_set_text( Info, string_format(UPDATE_FMT, CanvasMs, AudioLen, ObjectCount) )
			end
		UpdateCanvas(AudioPlaying)
	end
end

function on_input(self, action_id, action)
	return true, (InputMode and InputModeFns[action_id] or ActionFns[action_id] or NIL)(action)
end