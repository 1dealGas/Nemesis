name: "AcAudio"

platforms:
    x86_64-win32:
        context:
            flags: ["-std=c++14", "-O3", "-ffunction-sections", "-fdata-sections"]
            defines: ["MINIAUDIO_IMPLEMENTATION", "MA_NO_FLAC", "MA_NO_OPUS", "MA_NO_VORBIS", "MA_NO_ENCODING", "MA_NO_GENERATION", "MA_ENABLE_ONLY_SPECIFIC_BACKENDS", "MA_ENABLE_WASAPI"]

    x86_64-linux:
        context:
            flags: ["-std=c++11", "-O3", "-ffunction-sections", "-fdata-sections", "-flto", "-Wno-deprecated-declarations"]
            linkFlags: ["-flto"]
            defines: ["MINIAUDIO_IMPLEMENTATION", "MA_NO_FLAC", "MA_NO_OPUS", "MA_NO_VORBIS", "MA_NO_ENCODING", "MA_NO_GENERATION", "MA_ENABLE_ONLY_SPECIFIC_BACKENDS", "MA_ENABLE_ALSA"]

    x86_64-osx:
        context:
            flags: ["-std=c++11", "-O3", "-ffunction-sections", "-fdata-sections", "-flto", "-Wno-deprecated-declarations"]
            linkFlags: ["-flto"]
            defines: ["MINIAUDIO_IMPLEMENTATION", "MA_NO_FLAC", "MA_NO_OPUS", "MA_NO_VORBIS", "MA_NO_ENCODING", "MA_NO_GENERATION", "MA_ENABLE_ONLY_SPECIFIC_BACKENDS", "MA_ENABLE_COREAUDIO"]

    arm64-osx:
        context:
            flags: ["-std=c++11", "-O3", "-ffunction-sections", "-fdata-sections", "-flto", "-Wno-deprecated-declarations"]
            linkFlags: ["-flto"]
            defines: ["MINIAUDIO_IMPLEMENTATION", "MA_NO_FLAC", "MA_NO_OPUS", "MA_NO_VORBIS", "MA_NO_ENCODING", "MA_NO_GENERATION", "MA_ENABLE_ONLY_SPECIFIC_BACKENDS", "MA_ENABLE_COREAUDIO"]